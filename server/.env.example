# Local server port (Render supplies PORT automatically in production).
PORT=5000

# MongoDB Atlas connection string. Never commit the real credential.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio

# Comma-separated client origins, without paths.
CLIENT_URL=http://localhost:5173,https://your-portfolio.vercel.app

# Google reCAPTCHA v2 secret key. Required in production.
RECAPTCHA_SECRET_KEY=

# Optional LLM for smarter chatbot answers (recommended: free Groq key).
# Without a key, the bot still answers from local portfolio knowledge.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

NODE_ENV=development
